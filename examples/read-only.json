{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadReports",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::example-reports",
        "arn:aws:s3:::example-reports/*"
      ]
    },
    {
      "Sid": "DescribeCompute",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "elasticloadbalancing:Describe*"],
      "Resource": "*"
    }
  ]
}
